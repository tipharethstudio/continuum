---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/globals.css';
import '../styles/theme-everforest-zen.css';
import '../styles/theme-aubergine.css';
import '../styles/theme-petrol.css';
import '../styles/theme-espresso.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'A workstation for Intent Engineering. Signals become refined briefs, briefs become fleets of agents, and done is verified against the remote. Intent is the input; code is a byproduct.',
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(Astro.url.pathname, site);
---

<!DOCTYPE html>
<html lang="en" data-theme="aubergine">
  <head>
    <script is:inline>
      document.documentElement.dataset.theme =
        localStorage.getItem('continuum-theme') || 'aubergine';
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/continuum.svg`} />
    <link rel="alternate icon" type="image/png" href={`${base}/continuum-128.png`} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Continuum" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Theme picker: easter egg, revealed with Cmd+Alt+X -->
    <div id="theme-picker" hidden class="fixed bottom-4 right-4 z-50 glass-pane px-3 py-2 flex items-center gap-2"
         role="group" aria-label="Theme picker">
      {[
        ['catppuccin', '#1e1e2e', '#89b4fa'],
        ['everforest', '#252a23', '#a6e3a1'],
        ['aubergine', '#211a30', '#cba6f7'],
        ['petrol', '#163036', '#94e2d5'],
        ['espresso', '#27211d', '#fab387'],
      ].map(([name, bg, dot]) => (
        <button
          class="theme-dot w-6 h-6 rounded-full border border-[rgba(255,255,255,0.25)] cursor-pointer"
          style={`background: radial-gradient(circle at 35% 35%, ${dot} 0%, ${dot} 28%, ${bg} 34%)`}
          data-set-theme={name}
          title={name}
          aria-label={`Switch to ${name} theme`}
        ></button>
      ))}
    </div>
    <script is:inline>
      document.querySelectorAll('[data-set-theme]').forEach((b) =>
        b.addEventListener('click', () => {
          const t = b.dataset.setTheme;
          document.documentElement.dataset.theme = t;
          localStorage.setItem('continuum-theme', t);
        })
      );
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.altKey && e.code === 'KeyX') {
          e.preventDefault();
          const p = document.getElementById('theme-picker');
          p.hidden = !p.hidden;
        }
      });
    </script>
  </body>
</html>
