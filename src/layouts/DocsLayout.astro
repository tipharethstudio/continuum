---
// Docs layout: the same shell as the landing, plus a sticky section index.
// The landing tells the story; these pages hold the machinery it points at.
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  color?: string;
  intro?: string;
}

const { title, description, eyebrow = 'Docs', color = '#89b4fa', intro } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const nav = [
  { href: `${base}/docs/`, label: 'Overview' },
  { href: `${base}/docs/intent-engineering/`, label: 'Intent Engineering' },
  { href: `${base}/docs/how-it-works/`, label: 'How it works' },
  { href: `${base}/docs/architecture/`, label: 'Architecture' },
  { href: `${base}/docs/evidence/`, label: 'Evidence' },
  { href: `${base}/docs/vocabulary/`, label: 'Vocabulary' },
  { href: `${base}/docs/gradients/`, label: 'Gradients' },
];
const current = Astro.url.pathname.replace(/\/$/, '');
---

<BaseLayout title={`${title} · Continuum docs`} description={description}>
  <div class="max-w-7xl mx-auto px-6 pt-10 md:pt-14 grid lg:grid-cols-[200px_1fr] gap-10">
    <aside class="hidden lg:block">
      <div class="sticky top-20">
        <div class="eyebrow mb-3" style="color:#d4af37;">Docs</div>
        <ul class="flex flex-col gap-1.5 text-[0.8125rem]">
          {nav.map((n) => {
            const active = n.href.replace(/\/$/, '') === current;
            return (
              <li>
                <a
                  href={n.href}
                  class={`block px-2 py-1 rounded-md transition-colors ${
                    active ? 'text-text-primary bg-[rgba(255,255,255,0.05)]' : 'text-text-muted hover:text-text-primary'
                  }`}
                >
                  {n.label}
                </a>
              </li>
            );
          })}
        </ul>
        <p class="mt-6 font-mono text-[0.625rem] text-text-dim leading-relaxed">
          The landing page tells the story. These pages hold the machinery behind it.
        </p>
      </div>
    </aside>

    <div class="min-w-0">
      <span class="eyebrow mb-3 block" style={`color:${color};`}>{eyebrow}</span>
      <h1 class="text-[2rem] md:text-[2.5rem] mb-4">{title}</h1>
      {intro && <p class="text-text-muted max-w-[640px] mb-6">{intro}</p>}
      <nav class="lg:hidden mb-8 flex flex-wrap gap-2 text-[0.75rem] font-mono">
        {nav.map((n) => (
          <a href={n.href} class="px-2.5 py-1 rounded-md border border-surface1 text-text-muted hover:text-text-primary">{n.label}</a>
        ))}
      </nav>
      <div class="docs-body">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* Legacy landing sections carry their own max-width and padding; inside docs they sit in the content column. */
  .docs-body > section { padding-left: 0; padding-right: 0; }
  .docs-body > section > .relative.max-w-7xl,
  .docs-body > section > .max-w-7xl { max-width: none; }
</style>
