---
// The public task directory, listed. Files are served unedited from /public.
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dir = `${base}/proof/presidio-input-side-pii-scrub`;

const files = [
  ['brief.md', 'what was asked, exactly'],
  ['exploration.md', 'the gate that opened RESEARCHING'],
  ['research.md', 'the gate that opened PLANNING'],
  ['plan.md', 'the gate that opened IMPLEMENTING'],
  ['todo.md', 'the checklist the implementing session worked through'],
  ['validation.md', 'what "done" was defined to mean, then the actual results'],
  ['pr.md', 'the pull request text, PR #125'],
  ['sessions/2026-07-31T16-48-28.jsonl', 'every event of every session: hooks, tool calls, turns, cost'],
  ['task.yaml', 'the ledger: modes, turns, cost per stage, verdict, last action'],
];
---

<BaseLayout title="A real task directory · Continuum" description="tasks/presidio-input-side-pii-scrub, unedited: brief, stage files, session log, ledger.">
  <section class="py-12 md:py-16 px-6">
    <div class="max-w-4xl mx-auto">
      <span class="eyebrow mb-4 block" style="color:#d4af37;">Proof</span>
      <h1 class="text-[2rem] md:text-[2.5rem] mb-4">tasks/presidio-input-side-pii-scrub/</h1>
      <p class="text-text-muted max-w-[640px] mb-8">
        One task from the-saurus, run on 31 July 2026, exactly as it left its directory.
        The only edits: the operator's home path shortened to <span class="font-mono">~</span>,
        and the GitHub project item ids removed from task.yaml. Read the brief that was
        written before the code, then the validation that was written before "done".
      </p>
      <div class="glass-pane p-6">
        <ul class="font-mono text-[0.8125rem] flex flex-col gap-2">
          {files.map(([f, what]) => (
            <li class="flex flex-wrap gap-x-4 gap-y-1">
              <a href={`${dir}/${f}`} class="text-text-primary hover:text-[#89b4fa] min-w-[20rem]">{f}</a>
              <span class="text-text-dim">{what}</span>
            </li>
          ))}
        </ul>
      </div>
      <p class="mt-6 font-mono text-[0.6875rem] text-text-dim">
        Files open as plain text. <a href={`${base}/#line`} class="text-text-muted hover:text-text-primary">Back to the task on the line →</a>
      </p>
    </div>
  </section>
</BaseLayout>
