---
// Index of published task directories. One entry today; the per-task page
// lives at /proof/<slug>/, beside the files it lists.
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const tasks = [
  {
    slug: 'presidio-input-side-pii-scrub',
    repo: 'the-saurus',
    ran: '31 July 2026',
    what: 'input-side PII scrub, six modes, PR #125',
  },
];
---

<BaseLayout title="Task directories · Continuum" description="Real Continuum task directories, published unedited: briefs, stage files, session logs, ledgers.">
  <section class="py-12 md:py-16 px-6">
    <div class="max-w-4xl mx-auto">
      <span class="eyebrow mb-4 block" style="color:#d4af37;">Proof</span>
      <h1 class="text-[2rem] md:text-[2.5rem] mb-4">Task directories</h1>
      <p class="text-text-muted max-w-[640px] mb-8">
        Real tasks, published exactly as they left their directories — the brief written
        before the code, the gates that opened each mode, the session log, the ledger.
      </p>
      <div class="glass-pane p-6">
        <ul class="flex flex-col gap-4">
          {tasks.map((t) => (
            <li class="flex flex-col gap-1">
              <a href={`${base}/proof/${t.slug}/`} class="font-mono text-[0.8125rem] text-text-primary hover:text-[#89b4fa]">tasks/{t.slug}/</a>
              <span class="text-[0.8125rem] text-text-dim">{t.what} · {t.repo} · {t.ran}</span>
            </li>
          ))}
        </ul>
      </div>
      <p class="mt-6 font-mono text-[0.6875rem] text-text-dim">
        <a href={`${base}/#line`} class="text-text-muted hover:text-text-primary">Back to the task on the line →</a>
      </p>
    </div>
  </section>
</BaseLayout>
