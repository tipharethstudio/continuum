---
// Claim 2 · the session is not the unit of work.
// Geometry: continuity-vs-interrupted. Sessions end at the window; the task
// crosses every break because each stage left a file the next one opens.
---

<svg class="fig" viewBox="0 0 620 166" fill="none" xmlns="http://www.w3.org/2000/svg"
     role="img"
     aria-label="Above, a broken line whose interruptions land exactly in the empty stretches: sessions that end at the context window and restart from nothing. Below, one unbroken line spanning the same distance, marked with the five files each stage leaves behind: the task that crosses every break.">

  <!-- INVARIANT. Dash math, unchanged from the template:
         line runs x = 40 -> 600  (length 560)
         stroke-dasharray 17.5 17.5  -> period 35, exactly 16 periods
         gap CENTRE k = 66.25 + 35k
       Ticks use k = 0, 3, 6, 9, 12, 15, so every tick falls INSIDE a gap.
       A tick on a dash would show an interruption interrupting nothing.
       The five file markers sit on the unbroken line at 40, 180, 320, 460, 600:
       equal spacing, both endpoints included, so the task spans the same
       distance the sessions failed to span. -->

  <g font-family="var(--fig-label-font, 'Fira Code', monospace)" font-size="11.5">

    <text x="40" y="30" fill="var(--fig-ink, currentColor)" opacity="0.85">sessions: each one ends at the window, the next starts from nothing</text>

    <line x1="40" y1="58" x2="600" y2="58"
          stroke="var(--fig-ink, currentColor)" stroke-width="3" opacity="0.38"
          stroke-dasharray="17.5 17.5"/>

    <g stroke="var(--fig-ink, currentColor)" stroke-width="1" stroke-dasharray="3 3" opacity="0.55">
      <line x1="66.25"  y1="44" x2="66.25"  y2="72"/>
      <line x1="171.25" y1="44" x2="171.25" y2="72"/>
      <line x1="276.25" y1="44" x2="276.25" y2="72"/>
      <line x1="381.25" y1="44" x2="381.25" y2="72"/>
      <line x1="486.25" y1="44" x2="486.25" y2="72"/>
      <line x1="591.25" y1="44" x2="591.25" y2="72"/>
    </g>

    <text x="40" y="118" fill="var(--fig-accent, #d4af37)">the task: one file on disk opens the next stage</text>

    <line x1="40" y1="142" x2="600" y2="142"
          stroke="var(--fig-accent, #d4af37)" stroke-width="3" opacity="0.9" stroke-linecap="round"/>
    <g stroke="var(--fig-accent, #d4af37)" stroke-width="1.2" opacity="0.95"
       fill="var(--fig-accent, #d4af37)" fill-opacity="0.2">
      <circle cx="40"  cy="142" r="4.2"/>
      <circle cx="180" cy="142" r="4.2"/>
      <circle cx="320" cy="142" r="4.2"/>
      <circle cx="460" cy="142" r="4.2"/>
      <circle cx="600" cy="142" r="4.2"/>
    </g>
  </g>
</svg>
