---
const faqs = [
  {
    q: 'Is Continuum another AI coding IDE?',
    a: 'No. Continuum sits a layer above the editor and the agent. IDEs and coding agents execute; Continuum owns what happens before execution (turning raw demand into executable briefs) and after it (verifying that what merged is what was asked). It works alongside whatever editor and agent you already use.',
  },
  {
    q: 'Which models does it work with?',
    a: 'Continuum is model-agnostic by construction. Workflow modes, gates and per-model strictness insulate the system from vendor variance, and inference rides the subscription you already pay for. There is no API-key metering and no per-token markup.',
  },
  {
    q: 'Where does my code and work state live?',
    a: 'In your repositories and your git. Work state is YAML and markdown in a directory tree beside the work; there is no server, no account, and no second system holding a copy of what is true. Nothing to exfiltrate to.',
  },
  {
    q: 'Does it really run unattended?',
    a: 'Yes, when you want it to. A signal can run from capture to implementation without a touch. The run escalates only three kinds of decision (scope, a fact only you know, an outward-facing effect), notifies you on desktop and mobile, and records every routine arbitration with its rationale. The merge is always yours.',
  },
  {
    q: 'Can I use it today?',
    a: 'Continuum has run its creator’s daily work since 2025 and is being hardened for external users. The behavioral standards layer (the gradients: arché, shodo, kinhin, zazen) is open source and in third-party use today. For early access or a pilot, get in touch.',
  },
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'Continuum',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'macOS',
      description:
        'A desktop workstation for Intent Engineering: raw demand becomes executable briefs, briefs run through fleets of coding agents, and delivery is verified against the remote.',
      author: { '@type': 'Organization', name: 'Tiphareth Studio' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
});
---

<section id="faq" class="py-8 md:py-14 px-6 relative scroll-mt-14">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-0 -left-1/5 w-[600px] h-[600px] rounded-full opacity-[0.08]"
         style="background: radial-gradient(circle, #89dceb 0%, transparent 70%);"></div>
  </div>
  <div class="continuum-rule max-w-7xl mx-auto absolute top-0 left-1/2 -translate-x-1/2 w-full"></div>
  <div class="relative max-w-4xl mx-auto">
    <span class="eyebrow mb-4 block" style="color: #89dceb;">Questions</span>
    <h2 class="text-[1.875rem] md:text-[2.25rem] mb-10">Asked before you ask.</h2>

    <div class="flex flex-col gap-3">
      {faqs.map((f) => (
        <details class="glass-card px-6 py-4 group">
          <summary class="cursor-pointer list-none flex items-center justify-between gap-4 text-[0.9375rem] font-display font-semibold text-text-primary">
            {f.q}
            <span class="font-mono text-text-dim text-[0.875rem] group-open:rotate-45 transition-transform shrink-0">+</span>
          </summary>
          <p class="mt-3 text-[0.8438rem] text-text-muted leading-relaxed max-w-[70ch]">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={jsonLd} />
