---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="sticky top-0 z-40 glass-pane rounded-none border-x-0 border-t-0">
  <div class="max-w-7xl mx-auto px-6 h-14 flex items-center justify-between">
    <a href={`${base}/`} class="flex items-center gap-2.5 group">
      <img src={`${base}/continuum.svg`} alt="" width="34" height="34" aria-hidden="true" />
      <span class="font-display font-semibold text-[0.9375rem] text-text-primary tracking-tight">Continuum</span>
    </a>

    <nav class="flex items-center gap-5 text-[0.8125rem] text-text-muted">
      <a href={`${base}/#problem`} class="hover:text-text-primary hidden sm:inline">Problem</a>
      <a href={`${base}/#distill`} class="hover:text-text-primary hidden sm:inline">Product</a>
      <a href={`${base}/#architecture`} class="hover:text-text-primary hidden md:inline">Architecture</a>
      <a href={`${base}/#evidence`} class="hover:text-text-primary hidden md:inline">Evidence</a>
      <a href={`${base}/blog/`} class="hover:text-text-primary">Blog</a>
      <a href={`${base}/press/`} class="hover:text-text-primary hidden sm:inline">Press</a>
      <a
        href="https://daviguides.github.io/articles/machine-learning/2026/04/25/intent-engineering.html"
        class="px-3 py-1.5 rounded-lg border border-[rgba(212,175,55,0.4)] text-[#d4af37] hover:bg-[rgba(212,175,55,0.08)] transition-colors text-[0.75rem] font-mono"
      >
        The article
      </a>
    </nav>
  </div>
</header>
