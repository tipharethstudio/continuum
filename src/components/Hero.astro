---
// The hero shows the thesis and the product in one glance: a stylized
// Intent Distill line, one row per signal, capture through verified delivery.
const rows = [
  {
    signal: 'slack: "checkout retries are silently swallowed"',
    stages: ['captured', 'refined', 'briefs ×4', 'queued', 'implementing'],
    state: 'running',
  },
  {
    signal: 'meeting: Q3 metrics dashboard for the board',
    stages: ['captured', 'refined', 'briefs ×7', 'queued', 'verified'],
    state: 'done',
  },
  {
    signal: 'idea @ 02:14: unify auth across the two APIs',
    stages: ['captured', 'refining'],
    state: 'needs-you',
  },
];

const chipStyle: Record<string, string> = {
  captured: 'color:#f9e2af;border-color:rgba(249,226,175,.4);background:rgba(249,226,175,.06)',
  refined: 'color:#89dceb;border-color:rgba(137,220,235,.4);background:rgba(137,220,235,.06)',
  refining: 'color:#89dceb;border-color:rgba(137,220,235,.4);background:rgba(137,220,235,.06)',
  queued: 'color:#cba6f7;border-color:rgba(203,166,247,.4);background:rgba(203,166,247,.06)',
  implementing: 'color:#a6e3a1;border-color:rgba(166,227,161,.4);background:rgba(166,227,161,.06)',
  verified: 'color:#d4af37;border-color:rgba(212,175,55,.5);background:rgba(212,175,55,.08)',
};
const briefStyle = 'color:#89b4fa;border-color:rgba(137,180,250,.4);background:rgba(137,180,250,.06)';
---

<section class="relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 pt-12 pb-16 md:pt-16 md:pb-20">
    <!-- Status badge -->
    <div class="animate-emerge mb-8">
      <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-[0.6875rem] font-mono
                   glass-card text-text-muted">
        <span class="w-1.5 h-1.5 rounded-full bg-[#a6e3a1] breathing"></span>
        Daily-driven in production since 2025 · 1,000+ tasks · multiple real organizations
      </span>
    </div>

    <div class="grid lg:grid-cols-[1fr_1.05fr] gap-12 items-center">
      <!-- Copy -->
      <div>
        <h1 class="text-[2.6rem] md:text-[3.3rem] lg:text-[3.6rem] leading-[1.02] animate-emerge"
            style="animation-delay: 100ms;">
          Intent is the input.<br />
          <span class="relative inline-block">Code is a byproduct.
            <svg class="absolute -bottom-1.5 left-0 w-full h-[3px]" viewBox="0 0 100 3" preserveAspectRatio="none" aria-hidden="true">
              <line x1="0" y1="1.5" x2="100" y2="1.5" stroke="url(#hero-grad)" stroke-width="2.5" />
              <defs>
                <linearGradient id="hero-grad" x1="0" x2="100" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#89b4fa" />
                  <stop offset="50%" stop-color="#d4af37" />
                  <stop offset="100%" stop-color="#cba6f7" />
                </linearGradient>
              </defs>
            </svg>
          </span>
        </h1>

        <p class="mt-7 text-lg text-text-secondary max-w-[560px] animate-emerge" style="animation-delay: 200ms;">
          <span class="text-text-primary font-medium">Not another AI coding IDE.</span>
          Continuum is a workstation for <strong>Intent Engineering</strong>, the layer above
          your editor and your agents: a raw signal (a thread, a meeting, a 3am idea) becomes
          refined briefs, briefs become a fleet of agents, and <em class="not-italic text-text-primary">done
          is verified against the remote</em>, not declared by the agent.
        </p>

        <p class="mt-4 text-[0.875rem] text-text-muted max-w-[520px] animate-emerge" style="animation-delay: 250ms;">
          Fire-and-forget when you want it. The line runs unattended and notifies you,
          desktop and mobile, the moment something deserves your answer.
          <span class="font-mono text-[0.8125rem] text-[#d4af37]">The line never sits idle.</span>
        </p>

        <div class="mt-8 flex flex-wrap gap-3 animate-emerge" style="animation-delay: 350ms;">
          <a href="#problem"
             class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-[0.8125rem] font-medium
                    bg-text-primary text-crust hover:bg-text-secondary transition-colors">
            Discover more
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </a>
          <a href="#evidence"
             class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-[0.8125rem]
                    border border-surface1 text-text-secondary hover:border-text-dim
                    hover:text-text-primary transition-all">
            The evidence
          </a>
        </div>

        <!-- Measured strip -->
        <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2 font-mono text-[0.6875rem] text-text-dim animate-emerge"
             style="animation-delay: 450ms;">
          <span>1 signal → <span class="text-[#89b4fa]">22 briefs</span> → 22 GitHub issues</span>
          <span><span class="text-[#d4af37]">0</span> human touches on a typical run</span>
          <span>~<span class="text-[#a6e3a1]">$2</span> per full task</span>
          <span>state in your git, not our SaaS</span>
        </div>
      </div>

      <!-- The distillation line, stylized from the real surface -->
      <div class="animate-emerge" style="animation-delay: 400ms;">
        <div class="glass-pane p-4 md:p-5">
          <div class="flex items-center justify-between mb-4 px-1">
            <span class="eyebrow" style="color:#89b4fa;">Intent Distill</span>
            <span class="font-mono text-[0.625rem] text-text-dim">one line per signal · capture → verified</span>
          </div>

          <div class="flex flex-col gap-2.5">
            {rows.map((row) => (
              <div class="glass-card px-4 py-3">
                <div class="font-mono text-[0.71875rem] text-text-secondary truncate">{row.signal}</div>
                <div class="mt-2 flex items-center gap-1.5 flex-wrap">
                  {row.stages.map((s, i) => (
                    <>
                      {i > 0 && <span class="text-surface1 font-mono text-[0.625rem]">·</span>}
                      <span
                        class={`stage-chip ${s === 'implementing' || s === 'refining' ? 'breathing' : ''}`}
                        style={s.startsWith('briefs') ? briefStyle : chipStyle[s]}
                      >{s.toUpperCase()}</span>
                    </>
                  ))}
                  {row.state === 'needs-you' && (
                    <span class="ml-auto stage-chip" style="color:#fab387;border-color:rgba(250,179,135,.5);background:rgba(250,179,135,.08)">
                      NEEDS YOU
                    </span>
                  )}
                  {row.state === 'done' && (
                    <span class="ml-auto font-mono text-[0.625rem] text-[#d4af37]">✓ on the remote</span>
                  )}
                </div>
              </div>
            ))}
          </div>

          <div class="mt-4 px-1 flex items-center justify-between font-mono text-[0.625rem] text-text-dim">
            <span>receipts: every action taken in your name, with the criterion</span>
            <span class="text-[#fab387]">1 waiting on you</span>
          </div>
        </div>
      </div>
    </div>
    <!-- Definition block: plain-language, right after the visual hook -->
    <div class="mt-12 glass-pane p-6 md:p-8 animate-emerge" style="animation-delay: 500ms;">
      <div class="flex items-baseline justify-between gap-4 mb-5">
        <span class="eyebrow" style="color:#d4af37;">What is Continuum?</span>
        <span class="font-mono text-[0.625rem] text-text-dim">the rest of this page is the long answer</span>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        <div>
          <div class="text-[0.9375rem] font-display font-semibold text-text-primary mb-1">Above, not instead</div>
          <p class="text-[0.8125rem] text-text-muted">A desktop workstation that sits above your editor and your agents. Keep both.</p>
        </div>
        <div>
          <div class="text-[0.9375rem] font-display font-semibold text-text-primary mb-1">Demand in, delivery out</div>
          <p class="text-[0.8125rem] text-text-muted">A raw signal becomes briefs, briefs become a fleet, and done is proven on the remote.</p>
        </div>
        <div>
          <div class="text-[0.9375rem] font-display font-semibold text-text-primary mb-1">Your job moves up</div>
          <p class="text-[0.8125rem] text-text-muted">The typing goes to the fleet. Intent and judgment stay with you.</p>
        </div>
      </div>
    </div>
  </div>
  <div class="continuum-rule max-w-7xl mx-auto"></div>
</section>
